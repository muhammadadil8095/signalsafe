# SignalSafe Campus - Environment Configuration
# Copy this file to .env and update values as needed

# Application Settings
APP_NAME=SignalSafe Campus
VERSION=1.0.0
DEBUG=False

# Database
DATABASE_URL=sqlite:///./signalsafe.db

# JWT Authentication
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# VirusTotal Integration
VT_API_KEY=
VT_ENABLED=False
VT_TIMEOUT=30
VT_RATE_LIMIT=4

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=[".pdf", ".html", ".htm"]

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ML Model Paths
ML_MODEL_PATH=ml/models/url_phishing_model.joblib
ML_PIPELINE_PATH=ml/models/feature_pipeline.joblib
