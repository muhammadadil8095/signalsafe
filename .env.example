# SignalSafe Campus Environment Configuration

# Application
APP_NAME="SignalSafe Campus"
VERSION="1.0.0"
DEBUG=true

# Database
DATABASE_URL=sqlite:///./signalsafe.db

# JWT Security
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# VirusTotal API (Optional - leave empty for heuristic-only mode)
VT_API_KEY=
VT_ENABLED=false
VT_TIMEOUT=30
VT_RATE_LIMIT=4

# URLhaus Threat Intel (abuse.ch)
URLHAUS_ENABLED=true
URLHAUS_AUTH_KEY=
URLHAUS_TIMEOUT=5

# ML Models
ML_MODEL_PATH=ml/models/url_phishing_model.joblib
ML_PIPELINE_PATH=ml/models/feature_pipeline.joblib

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

